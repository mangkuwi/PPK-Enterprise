# Salin menjadi .env di VPS. Jangan pernah commit .env.
DOMAIN=gateway.contoh.go.id
POSTGRES_PASSWORD=ganti-dengan-kata-sandi-acak
# Token bebas buatan Anda; isi sama persis di Meta (WhatsApp > Configuration > Verify token).
WA_VERIFY_TOKEN=ganti-dengan-token-acak
# Meta App > Settings > Basic > App secret. Dipakai memeriksa tanda tangan webhook.
WA_APP_SECRET=
# Token akses permanen System User (izin whatsapp_business_messaging). Hanya untuk mengunduh lampiran.
WA_ACCESS_TOKEN=
WA_GRAPH_VERSION=v21.0
# Kunci untuk aplikasi desktop, minimal 32 karakter. Buat dengan: openssl rand -hex 32
GATEWAY_API_KEY=
