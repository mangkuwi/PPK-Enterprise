{
  "name": "naskahdinas-ai",
  "productName": "NASKAHDINAS AI",
  "version": "1.0.0",
  "description": "NASKAHDINAS AI – Smart Document Generator untuk naskah dinas pemerintahan (Windows dan macOS, offline).",
  "author": "NASKAHDINAS AI",
  "license": "UNLICENSED",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:renderer": "vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "test": "vitest run --exclude tests/db.test.ts --exclude tests/importer.test.ts --exclude tests/variants.test.ts --exclude tests/numbering.test.ts --exclude tests/numbering-import.test.ts --exclude tests/numbering-integration.test.ts --exclude tests/numbering-pool.test.ts",
    "test:db": "node scripts/test-db.mjs",
    "test:all": "npm run test && npm run test:db",
    "build": "npm run typecheck && npm run build:renderer && npm run build:electron",
    "rebuild:electron": "node scripts/rebuild-electron-abi.mjs",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --win nsis portable --x64",
    "dist:mac": "npm run build && electron-builder --mac dmg zip",
    "postinstall": "node scripts/rebuild-electron-abi.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "pdfjs-dist": "^6.2.108"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.0",
    "@tiptap/extension-font-family": "^2.10.3",
    "@tiptap/extension-image": "^2.10.3",
    "@tiptap/extension-table": "^2.10.3",
    "@tiptap/extension-table-cell": "^2.10.3",
    "@tiptap/extension-table-header": "^2.10.3",
    "@tiptap/extension-table-row": "^2.10.3",
    "@tiptap/extension-text-align": "^2.10.3",
    "@tiptap/extension-text-style": "^2.10.3",
    "@tiptap/extension-underline": "^2.10.3",
    "@tiptap/pm": "^2.10.3",
    "@tiptap/react": "^2.10.3",
    "@tiptap/starter-kit": "^2.10.3",
    "@types/adm-zip": "^0.5.6",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "adm-zip": "^0.5.16",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx": "^9.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.12.0",
    "lucide-react": "^0.460.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "tailwind-merge": "^2.5.5",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "zod": "^3.23.8"
  }
}
